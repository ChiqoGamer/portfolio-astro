# ── Chat de Plumita ──────────────────────────────────────────────
# Con una sola clave alcanza. Si están las dos, Groq es el principal y Gemini el respaldo.
# Groq (gratis):   https://console.groq.com/keys
GROQ_API_KEY=tu_api_key_de_groq
# Gemini (gratis): https://aistudio.google.com/apikey
GEMINI_API_KEY=tu_api_key_de_gemini

# Opcionales
# GROQ_MODEL=openai/gpt-oss-120b,openai/gpt-oss-20b,qwen/qwen3.8-27b
# GEMINI_MODEL=gemini-2.5-flash-lite

# Solo desarrollo: URL del servidor local del chat (npm run dev:chat)
PUBLIC_CHAT_API_URL=http://localhost:3001/api/chat
